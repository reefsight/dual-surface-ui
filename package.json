{
  "name": "dual-surface-ui",
  "version": "0.1.0",
  "description": "A semantic interaction layer that lets AI agents understand and operate web UIs without changing the human interface.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./webmcp": {
      "types": "./dist/webmcp/index.d.ts",
      "import": "./dist/webmcp/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "import": "./dist/mcp/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./angular": {
      "types": "./dist/angular/index.d.ts",
      "import": "./dist/angular/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    },
    "./domain": {
      "types": "./dist/domain/index.d.ts",
      "import": "./dist/domain/index.js"
    },
    "./drift": {
      "types": "./dist/drift/index.d.ts",
      "import": "./dist/drift/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js"
    },
    "./delta": {
      "types": "./dist/delta/index.d.ts",
      "import": "./dist/delta/index.js"
    },
    "./trace": {
      "types": "./dist/trace/index.d.ts",
      "import": "./dist/trace/index.js"
    },
    "./replay": {
      "types": "./dist/replay/index.d.ts",
      "import": "./dist/replay/index.js"
    },
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "import": "./dist/cli/index.js"
    }
  },
  "bin": {
    "dual-surface-ui": "./dist/cli/bin.js"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:angular",
    "build:core": "tsc -p tsconfig.json && node scripts/generate-schema.mjs && node scripts/generate-phase3-schema.mjs",
    "build:angular": "ngc -p angular/tsconfig.json",
    "contract:check": "npm run build && node scripts/check-phase1-contract.mjs",
    "package:check:delta": "npm run build && node scripts/check-delta-package.mjs",
    "package:check:trace-replay": "npm run build && node scripts/check-trace-replay-package.mjs",
    "package:check:playwright": "npm run build && node scripts/check-playwright-package.mjs",
    "package:check:cli": "npm run build && node scripts/check-cli-package.mjs",
    "example:checkout": "npm run build && node examples/checkout/run.mjs",
    "example:document-approval": "npm run build && node examples/document-approval/run.mjs",
    "example:legacy-form": "npm run build && node examples/legacy-form/run.mjs",
    "example:phase2": "npm run build && node examples/checkout/run.mjs && node examples/document-approval/run.mjs && node examples/legacy-form/run.mjs",
    "baseline:phase1": "npm run build && node scripts/measure-phase1-baseline.mjs",
    "schema:generate": "node scripts/generate-schema.mjs && node scripts/generate-phase3-schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run build:core && ngc -p angular/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:chromium": "playwright test --project=chromium",
    "test:browser:native": "playwright test --config playwright.native.config.ts",
    "test:gate": "node scripts/run-phase1-gate-tests.mjs",
    "test:watch": "vitest"
  },
  "keywords": [
    "ai-agent",
    "accessibility-tree",
    "semantic-ui",
    "computer-use",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "pngjs": "^7.0.0"
  },
  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^21.0.0 || ^22.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "playwright-core": ">=1.63.0 <2",
    "react": "^18.2.0 || ^19.0.0",
    "vue": ">=3.3.0 <3.6.0"
  },
  "peerDependenciesMeta": {
    "@angular/core": {
      "optional": true
    },
    "@modelcontextprotocol/server": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@angular/common": "20.3",
    "@angular/compiler": "20.3",
    "@angular/compiler-cli": "20.3",
    "@angular/core": "20.3",
    "@angular/platform-browser": "20.3",
    "@angular/platform-server": "20.3",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.4",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vue/server-renderer": "3.5.43",
    "jsdom": "^26.1.0",
    "playwright-core": "1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rxjs": "7.8",
    "tslib": "2.8",
    "typescript": "5.8.3",
    "vite": "8.3.0",
    "vitest": "^5.0.1",
    "vue": "3.5.43",
    "zone.js": "^0.15.1"
  }
}
