{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-surface-ui.dev/fixture/p4.2/manifest-0.1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "kind", "seed", "budgets", "controls"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "kind": { "const": "p4.2-windows-fixture-manifest" },
    "seed": { "const": "p4.2-seed-1" },
    "budgets": { "const": { "treeNodes": 512, "treeDepth": 32, "nameCharacters": 256, "valueCharacters": 64, "stateBytes": 4096, "reportBytes": 1048576, "events": 512 } },
    "controls": {
      "type": "array", "minItems": 1, "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "name", "role", "type", "patterns", "action"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "role": { "enum": ["window", "button", "textbox", "checkbox", "listbox", "option", "combobox", "radio", "tablist", "tab", "slider", "generic", "text", "status"] },
          "type": { "enum": ["Window", "Button", "Edit", "CheckBox", "List", "ListItem", "ComboBox", "RadioButton", "Tab", "TabItem", "Group", "Slider", "Custom", "Text"] },
          "patterns": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["Window", "Invoke", "Value", "Toggle", "Selection", "SelectionItem", "ExpandCollapse", "RangeValue"] } },
          "action": { "enum": ["none", "click", "set_value", "toggle", "select", "expand", "set_range"] }
        }
      }
    }
  }
}
