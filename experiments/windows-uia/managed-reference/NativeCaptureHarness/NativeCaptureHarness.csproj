<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <AssemblyName>DualSurface.UiaNativeCaptureHarness</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../CaptureHarness/CopiedObservation.cs" Link="Foundation/CopiedObservation.cs" />
    <Compile Include="../CaptureHarness/FixtureSubjects.cs" Link="Foundation/FixtureSubjects.cs" />
    <Compile Include="../CaptureHarness/SemanticProjection.cs" Link="Foundation/SemanticProjection.cs" />
  </ItemGroup>
</Project>
