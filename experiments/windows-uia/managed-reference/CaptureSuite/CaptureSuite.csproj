<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DualSurface.UiaCaptureSuite</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultItems>false</EnableDefaultItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="FailureDiagnostics.cs" />
    <Compile Include="FixtureRecords.cs" />
    <Compile Include="OwnedFiles.cs" />
    <Compile Include="Program.cs" />
    <Compile Include="SuiteFreeze.cs" />
    <Compile Include="TrustedSetup.cs" />
    <Compile Include="UnitCases.cs" />
    <Compile Include="../CaptureHarness/CopiedObservation.cs" Link="Foundation/CopiedObservation.cs" />
    <Compile Include="../CaptureHarness/FixtureSubjects.cs" Link="Foundation/FixtureSubjects.cs" />
    <Compile Include="../CaptureHarness/SemanticProjection.cs" Link="Foundation/SemanticProjection.cs" />
    <Compile Include="../NativeCaptureHarness/OwnedWindowTopology.cs" Link="Collector/OwnedWindowTopology.cs" />
    <Compile Include="../NativeCaptureHarness/OwnedWindowsAdmission.cs" Link="Collector/OwnedWindowsAdmission.cs" />
    <Compile Include="../NativeCaptureHarness/ReadOnlyCollector.cs" Link="Collector/ReadOnlyCollector.cs" />
  </ItemGroup>
</Project>
