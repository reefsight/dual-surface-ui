{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-surface-ui.dev/schema/agent-action-failure-0.1.json",
  "title": "Dual Surface UI Agent Action Failure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "surfaceId",
    "revision",
    "status",
    "error"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "surfaceId": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "failed"
    },
    "error": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "element_not_found"
            },
            "message": {
              "const": "The target element was not found"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "action_not_found"
            },
            "message": {
              "const": "The requested action is unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "authorization_required"
            },
            "message": {
              "const": "The action is not authorized"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "duplicate_element_id"
            },
            "message": {
              "const": "The surface contains duplicate element identifiers"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "surface_mismatch"
            },
            "message": {
              "const": "The request targets a different surface"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "stale_revision"
            },
            "message": {
              "const": "The observed surface revision is stale"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "invalid_input"
            },
            "message": {
              "const": "The action input is invalid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "confirmation_required"
            },
            "message": {
              "const": "The action requires trusted confirmation"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "invalid_policy_decision"
            },
            "message": {
              "const": "The policy decision is invalid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "precondition_failed"
            },
            "message": {
              "const": "An action precondition was not satisfied"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "verification_failed"
            },
            "message": {
              "const": "The action effects could not be verified"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "invalid_output"
            },
            "message": {
              "const": "The action output is invalid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "idempotency_key_required"
            },
            "message": {
              "const": "The action requires an idempotency key"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "invalid_idempotency_key"
            },
            "message": {
              "const": "The idempotency key is invalid"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "idempotency_conflict"
            },
            "message": {
              "const": "The idempotency key conflicts with an earlier request"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "idempotency_unavailable"
            },
            "message": {
              "const": "Secure idempotency protection is unavailable"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "const": "internal_error"
            },
            "message": {
              "const": "The action failed unexpectedly"
            }
          }
        }
      ]
    }
  }
}
