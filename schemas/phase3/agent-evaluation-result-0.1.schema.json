{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-surface-ui.dev/schema/agent-evaluation-result-0.1.json",
  "$comment": "Ordering, dimension parity, aggregate consistency, budgets, and secret scanning require captureAndValidateAgentEvaluationResult.",
  "title": "Dual Surface UI Deterministic Evaluation Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "suiteId",
    "definitionDigest",
    "driverId",
    "status",
    "caseCount",
    "dimensionCount",
    "cases",
    "dimensions",
    "environmentErrors"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "agent-evaluation-result"
    },
    "suiteId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "definitionDigest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "driverId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    },
    "caseCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 256
    },
    "dimensionCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "caseId",
              "status",
              "scores"
            ],
            "properties": {
              "caseId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "status": {
                "const": "scored"
              },
              "scores": {
                "type": "array",
                "minItems": 1,
                "maxItems": 32,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "dimension",
                    "earned",
                    "possible"
                  ],
                  "properties": {
                    "dimension": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                    },
                    "earned": {
                      "enum": [
                        0,
                        1
                      ]
                    },
                    "possible": {
                      "const": 1
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "caseId",
              "status",
              "code"
            ],
            "properties": {
              "caseId": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "status": {
                "const": "environment_error"
              },
              "code": {
                "const": "environment_unavailable"
              }
            }
          }
        ]
      }
    },
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dimension",
          "earned",
          "possible",
          "unscored"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "earned": {
            "type": "integer",
            "minimum": 0
          },
          "possible": {
            "type": "integer",
            "minimum": 0
          },
          "unscored": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "environmentErrors": {
      "type": "integer",
      "minimum": 0
    }
  }
}
