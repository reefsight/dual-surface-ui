{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-surface-ui.dev/schema/native/native-protocol-data-0.1.json",
  "title": "Dual Surface UI Native Protocol Data Messages 0.1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "sessionRef"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "kind": {
          "const": "surface-list-request"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "sessionRef",
        "surfaces"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "kind": {
          "const": "surface-list-response"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "surfaces": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "surfaceRef",
              "revision",
              "title",
              "application",
              "capabilities",
              "actionCount"
            ],
            "properties": {
              "surfaceRef": {
                "type": "string",
                "pattern": "^[A-Za-z0-9._~-]{1,128}$"
              },
              "revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "title": {
                "type": "string",
                "maxLength": 500
              },
              "application": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "capabilities": {
                "type": "array",
                "maxItems": 6,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "actions",
                    "cancellation",
                    "deltas",
                    "events",
                    "snapshots",
                    "surface-catalog"
                  ]
                }
              },
              "actionCount": {
                "type": "integer",
                "minimum": 0,
                "maximum": 128
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "sessionRef",
        "surfaceRef"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "kind": {
          "const": "snapshot-request"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "surfaceRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "sessionRef",
        "surfaceRef",
        "snapshot"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "kind": {
          "const": "snapshot-response"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "surfaceRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "snapshot": {
          "$ref": "https://dual-surface-ui.dev/schema/agent-snapshot-0.1.json"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "sessionRef",
        "surfaceRef",
        "baseRevision",
        "baseDigest"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "kind": {
          "const": "delta-request"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "surfaceRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "baseRevision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "baseDigest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "kind",
        "requestId",
        "sessionRef",
        "surfaceRef",
        "delta"
      ],
      "properties": {
        "schemaVersion": {
          "const": "0.1"
        },
        "kind": {
          "const": "delta-response"
        },
        "requestId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "sessionRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "surfaceRef": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._~-]{1,128}$"
        },
        "delta": {
          "$ref": "https://dual-surface-ui.dev/schema/agent-snapshot-delta-0.1.json"
        }
      }
    }
  ]
}
