{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dual-surface-ui.dev/schema/native/native-protocol-session-fixture-corpus-0.1.json",
  "title": "Dual Surface UI Native Protocol Session Fixture Corpus 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "kind": {
      "const": "native-protocol-session-fixture-corpus"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "messages",
          "expected"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]{1,96}$"
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 512,
            "items": {
              "type": "object"
            }
          },
          "expected": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "state"
                ],
                "properties": {
                  "status": {
                    "const": "accepted"
                  },
                  "state": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "phase",
                      "sessionRef",
                      "capabilities",
                      "activeRequests",
                      "completedRequests",
                      "surfaces",
                      "lastEventSequence",
                      "catalogStale"
                    ],
                    "properties": {
                      "phase": {
                        "enum": [
                          "awaiting-client-hello",
                          "awaiting-server-hello",
                          "active",
                          "closed"
                        ]
                      },
                      "sessionRef": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "capabilities": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string"
                        }
                      },
                      "activeRequests": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 128
                      },
                      "completedRequests": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4096
                      },
                      "surfaces": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 128
                      },
                      "lastEventSequence": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "catalogStale": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "code",
                  "failedAt",
                  "state"
                ],
                "properties": {
                  "status": {
                    "const": "rejected"
                  },
                  "code": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "failedAt": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 511
                  },
                  "state": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "phase",
                      "sessionRef",
                      "capabilities",
                      "activeRequests",
                      "completedRequests",
                      "surfaces",
                      "lastEventSequence",
                      "catalogStale"
                    ],
                    "properties": {
                      "phase": {
                        "enum": [
                          "awaiting-client-hello",
                          "awaiting-server-hello",
                          "active",
                          "closed"
                        ]
                      },
                      "sessionRef": {
                        "type": [
                          "string",
                          "null"
                        ]
                      },
                      "capabilities": {
                        "type": "array",
                        "uniqueItems": true,
                        "items": {
                          "type": "string"
                        }
                      },
                      "activeRequests": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 128
                      },
                      "completedRequests": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4096
                      },
                      "surfaces": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 128
                      },
                      "lastEventSequence": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "catalogStale": {
                        "type": "boolean"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  }
}
